# NPM configuration for Re-Habitar Frontend

# Registry
registry=https://registry.npmjs.org/

# Install verbosity
loglevel=warn

# Allow yarn lock file
#legacy-peer-deps=true

# Save exact versions (no caret/tilde)
save-exact=false

# Prefer exact matches
save-prefix=~

# Increase installation timeout (in milliseconds)
fetch-timeout=120000

# Network timeout (in milliseconds)
timeout=120000
