# Configuracion de Base de Datos PostgreSQL + PostGIS
POSTGRES_USER=rehabitar
POSTGRES_PASSWORD=rehabitar_pwd
POSTGRES_DB=rehabitar_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL de conexion asincrona (FastAPI + SQLAlchemy + asyncpg) y sincrona (ETL psycopg2)
DATABASE_URL_ASYNC=postgresql+asyncpg://rehabitar:rehabitar_pwd@db:5432/rehabitar_db
DATABASE_URL_SYNC=postgresql://rehabitar:rehabitar_pwd@db:5432/rehabitar_db

# Configuracion de APIs Externas y Timeouts (Segundos)
EXTERNAL_API_TIMEOUT=4
CARTOCIUDAD_ROUTE_URL=https://www.cartociudad.es/services/api/route
INE_API_BASE_URL=https://servicios.ine.es/wstempus/js/ES/DATOS_TABLA/2881
CAM_SANIDAD_CSV_URL=https://datos.comunidad.madrid/catalogo/dataset/centros_servicios_establecimientos_sanitarios/resource/centros_sanitarios.csv
BDNS_API_URL=https://www.infosubvenciones.es/bdnstrans/api/convocatorias

# Pesos por defecto del Motor WLC (Weighted Linear Combination) - Suman 1.0
WLC_WEIGHT_DEMO=0.35
WLC_WEIGHT_HEALTH=0.30
WLC_WEIGHT_GRANTS=0.20
WLC_WEIGHT_INFRA=0.15
